{
  "name": "@edgegamers/s2script-plugins",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "s2script": {
    "workspace": {
      "plugins": [
        "plugins/*"
      ]
    }
  },
  "scripts": {
    "license:check": "node scripts/check-licenses.mjs",
    "license:artifacts": "node scripts/check-license-artifacts.mjs",
    "create:plugin": "s2s create",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run --globals",
    "test:watch": "vitest --globals",
    "prebuild": "npm run license:check",
    "build": "s2s build",
    "postbuild": "npm run license:artifacts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:check": "node scripts/check-changeset.mjs",
    "release:plan": "node scripts/create-plugin-release-plan.mjs",
    "release:github-plugins": "node scripts/publish-github-plugin-releases.mjs",
    "deploy:registry-opt-ins": "node scripts/deploy-registry-opt-ins.mjs",
    "manifest:dev": "node scripts/create-dev-manifest.mjs",
    "artifacts:local": "npm run build && npm run manifest:dev && node scripts/collect-local-artifacts.mjs",
    "deploy:dev": "node scripts/deploy-development-artifacts.mjs",
    "version": "s2s version",
    "predeploy": "npm run build",
    "deploy": "s2s deploy"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@s2script/cs2": "^0.11.4",
    "@s2script/eslint-plugin": "0.2.0",
    "@s2script/sdk": "^0.14.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "fflate": "^0.8.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@s2script/cli": "^0.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
