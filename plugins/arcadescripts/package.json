{
  "name": "@edgegamers/s2s-arcadescripts",
  "version": "0.1.0",
  "description": "An s2script port of ArcadeScripts-CSS: TypeScript replacements for the VScripts that run jb_arcade_b6's minigames.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/plugin.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgegamers/edgegamers-s2s.git",
    "directory": "plugins/arcadescripts"
  },
  "bugs": {
    "url": "https://github.com/edgegamers/edgegamers-s2s/issues"
  },
  "homepage": "https://github.com/supergosciu/ArcadeScripts-CSS",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "translations/",
    "test/",
    "tsconfig.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "s2s build .",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "registry:pack": "s2s pack --dry-run"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
