{
  "name": "@edgegamers/ttt-ui",
  "version": "2.0.6",
  "type": "module",
  "description": "Existing-port private hudkit views; Core owns models and actions",
  "main": "src/plugin.ts",
  "types": "api.d.ts",
  "scripts": {
    "build": "s2s build .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "s2script": {
    "id": "ttt-ui",
    "game": "cs2",
    "publishes": {
      "@edgegamers/ttt-ui": "2.0.0"
    },
    "interfaceProtocol": 2,
    "pluginDependencies": {
      "@edgegamers/ttt-core": "^2.0.6"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edgegamers/edgegamers-s2s.git",
    "directory": "plugins/ttt/plugins/ui"
  },
  "dependencies": {
    "@edgegamers/ttt-contracts": "1.0.1"
  }
}
