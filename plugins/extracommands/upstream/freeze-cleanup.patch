+import test from "node:test";
+import assert from "node:assert/strict";
+import vm from "node:vm";
+import { readFileSync } from "node:fs";
+import { transformSync } from "esbuild";
+const source = transformSync(readFileSync(new URL("./plugin.ts", import.meta.url), "utf8"), { loader: "ts", format: "cjs" }).code;
+function fixture() {
+  const commands = new Map(), players = new Map(), timers = [];
+  let serial = 0;
+  const sdk = { command: { admin: (name, _flags, fn) => commands.set(name, fn) },
+    translations: { load() {} }, ADMFLAG: { SLAY: 32 }, HookResult: { Handled: 2 },
+    Clients: { fromSlot: slot => players.get(slot)?.client ?? null },
+    after(_ms, fn) { const t = { alive: true, fn, kill() { this.alive = false; } }; timers.push(t); return t; },
+  };
+  const module = { exports: {} };
+  vm.runInContext(source, vm.createContext({ module, exports: module.exports, require(name) {
+    if (name === "@s2script/sdk") return sdk;
+    if (name === "@s2script/cs2") return { Player: { fromSlot: slot => players.get(slot), target: () => [...players.values()] } };
+    throw Error(name);
+  } }));
+  const api = module.exports; api.OnPluginStart();
+  function pawn(p) { return p.pawn = { ref: { index: 100 + p.slot, id: ++serial }, isValid: true, lifeState: 0, moveType: 2 }; }
+  function player(slot = 1) {
+    const p = { slot, ref: { index: slot + 1, id: ++serial } };
+    p.client = { slot, isValid: () => players.get(slot) === p };
+    players.set(slot, p); pawn(p); return p;
+  }
+  return { api, players, timers, player, pawn, call(name = "sm_freeze", seconds = "1") {
+    commands.get(name)({ callerSlot: -1, arg: () => "@all", argFloat: () => Number(seconds), replyT() {} });
+  } };
+}
+test("freeze expiry cannot mutate a replacement connection or later pawn", () => {
+  for (const replacement of ["connection", "pawn"]) {
+    const f = fixture(), original = f.player(); f.call(); const timer = f.timers[0];
+    const next = replacement === "connection" ? f.player() : (f.pawn(original), original);
+    next.pawn.moveType = 7; timer.fn();
+    assert.equal(next.pawn.moveType, 7); assert.equal(timer.alive, false);
+  }
+});
+test("unfreeze cancels old expiry, which cannot cancel a later freeze", () => {
+  const f = fixture(), p = f.player(); f.call(); const old = f.timers[0];
+  f.call("sm_unfreeze"); assert.equal(p.pawn.moveType, 2); assert.equal(old.alive, false);
+  f.call(); old.fn(); assert.equal(p.pawn.moveType, 0);
+  f.timers[1].fn(); assert.equal(p.pawn.moveType, 2);
+});
+test("death, map boundaries and unload release tracked freezes and timers", () => {
+  for (const event of ["death", "OnMapStart", "OnMapEnd", "OnPluginEnd"]) {
+    const f = fixture(), p = f.player(); f.call();
+    if (event === "death") { p.pawn.lifeState = 1; f.api.OnGameFrame(); } else f.api[event]();
+    assert.equal(f.timers[0].alive, false); assert.equal(p.pawn.moveType, 2);
+  }
+});
+test("disconnect cancels only the disconnected connection's freeze", () => {
+  const f = fixture(), old = f.player(); f.call(); f.players.delete(1); f.api.OnClientDisconnect(old.client);
+  assert.equal(f.timers[0].alive, false);
+  const next = f.player(); f.call(); f.api.OnClientDisconnect(old.client);
+  assert.equal(next.pawn.moveType, 0); assert.equal(f.timers[1].alive, true);
+});
