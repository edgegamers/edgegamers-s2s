+// A freeze belongs to one connection and one pawn, never to a reusable player slot.
+interface FreezeState { client: Client; controller: EntityRef; pawn: EntityRef; expiry?: Timer }
+const freezes = new Map<number, FreezeState>();
+let clearingFreezes = false;
+let ended = false;
+function sameRef(a: EntityRef, b: EntityRef): boolean { return a.index === b.index && a.id === b.id; }
+function frozenPawn(state: FreezeState): Pawn | null {
+  if (!state.client.isValid()) return null;
+  const p = Player.fromSlot(state.client.slot);
+  if (!p || !sameRef(p.ref, state.controller)) return null;
+  const pawn = p.pawn;
+  return pawn?.isValid && sameRef(pawn.ref, state.pawn) ? pawn : null;
+}
+function stopFreeze(state: FreezeState): void {
+  if (freezes.get(state.client.slot) !== state) return;
+  freezes.delete(state.client.slot);
+  state.expiry?.kill();
+  const pawn = frozenPawn(state);
+  if (pawn?.moveType === NONE) pawn.moveType = WALK;
+}
+function freezePlayer(p: Player, pawn: Pawn, seconds: number): boolean {
+  if (clearingFreezes || ended) return false;
+  const client = Clients.fromSlot(p.slot);
+  if (!client?.isValid() || !pawn.isValid || pawn.lifeState !== 0 || pawn.moveType === null) return false;
+  const previous = freezes.get(p.slot);
+  if (previous) stopFreeze(previous);
+  const state: FreezeState = { client, controller: p.ref, pawn: pawn.ref };
+  freezes.set(p.slot, state);
+  try {
+    if (seconds > 0) state.expiry = after(seconds * 1000, () => stopFreeze(state));
+    if (freezes.get(p.slot) !== state || !frozenPawn(state)) { stopFreeze(state); return false; }
+    pawn.moveType = NONE;
+    if (pawn.moveType !== NONE) { stopFreeze(state); return false; }
+    return true;
+  } catch { stopFreeze(state); return false; }
+}
+function clearFreezes(): void {
+  if (clearingFreezes) return;
+  clearingFreezes = true;
+  try { for (const state of [...freezes.values()]) stopFreeze(state); }
+  finally { clearingFreezes = false; }
+}
