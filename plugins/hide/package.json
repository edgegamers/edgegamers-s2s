{
  "name": "@edgegamers/s2s-hide",
  "version": "1.3.5",
  "description": "An s2script port of edgegamers/CS2-HidePlayers using native clientprefs cookies.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/plugin.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgegamers/edgegamers-s2s.git",
    "directory": "plugins/hide"
  },
  "bugs": {
    "url": "https://github.com/ShookEagle/s2s-hide/issues"
  },
  "homepage": "https://github.com/ShookEagle/s2s-hide#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "translations/",
    "test/",
    "tsconfig.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "s2s build .",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "registry:pack": "s2s pack --dry-run"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
