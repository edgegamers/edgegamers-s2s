{
  "name": "@edgegamers/ttt-karma",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "main": "src/plugin.ts",
  "types": "api.d.ts",
  "scripts": {
    "build": "s2s build .",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@edgegamers/ttt-core": "0.1.0"
  },
  "s2script": {
    "apiVersion": "1.x",
    "pluginDependencies": {
      "@edgegamers/ttt-core": "^0.1.0"
    },
    "publishes": {
      "@edgegamers/ttt-karma": "0.1.0"
    },
    "config": {
      "karma_default": { "type": "int", "default": 50, "description": "Default karma for new or reset players" },
      "karma_min": { "type": "int", "default": 0, "description": "Minimum karma before low-karma punishment" },
      "karma_timeout_threshold": { "type": "int", "default": 20, "description": "Karma below which a player sits out" },
      "karma_round_timeout": { "type": "int", "default": 4, "description": "Rounds a low-karma player sits out" }
    }
  }
}
