{
  "name": "@edgegamers/jailbreak-rtd",
  "version": "1.1.3",
  "description": "Roll the dice: one random reward per player per round.",
  "main": "src/plugin.ts",
  "s2script": {
    "interfaceProtocol": 2,
    "libraries": {
      "@edgegamers/jailbreak-shared": "^1.0.0"
    },
    "pluginDependencies": {
      "@edgegamers/jailbreak-core": "^1.1.2"
    },
    "optionalPluginDependencies": {
      "@edgegamers/decluttr": "^1.0.0",
      "@edgegamers/jailbreak-warden": "^1.0.0",
      "@edgegamers/gangs": "^1.0.0"
    },
    "config": {
      "rtd_minplayers": {
        "type": "int",
        "default": 3,
        "description": "Minimum players on T/CT before anyone can roll the dice (-1 also disables !autortd)."
      },
      "autortd_flag": {
        "type": "string",
        "default": "o",
        "description": "SourceMod admin flag letter(s) required for auto-RTD (all required; \"\" = everyone). C# default was the @ego/dssilver permission."
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edgegamers/edgegamers-s2s.git",
    "directory": "plugins/jb/plugins/rtd"
  },
  "dependencies": {
    "@edgegamers/jailbreak-shared": "1.0.2"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  }
}
